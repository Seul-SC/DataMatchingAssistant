<Window x:Class="StudentScoreTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="/Assets/app.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="数据匹配助手" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="VersionTextBlock" Margin="0,4,0,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="作者："/>
            <Run FontWeight="SemiBold" Text="Seul_SC_照晨"/>
        </TextBlock>
        <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="GitHub："/>
            <Hyperlink NavigateUri="https://github.com/Seul-SC/DataMatchingAssistant"
                       RequestNavigate="ExternalLink_RequestNavigate">
                https://github.com/Seul-SC/DataMatchingAssistant
            </Hyperlink>
        </TextBlock>

        <Border Margin="0,22,0,0" Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="问题或建议" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="有问题或建议，可以直接发邮件给我，或在 GitHub 上留言。"/>
                <TextBlock Margin="0,14,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="邮箱："/>
                    <Hyperlink NavigateUri="mailto:1753534364@qq.com"
                               RequestNavigate="ExternalLink_RequestNavigate">
                        1753534364@qq.com
                    </Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="发送邮件" MinWidth="120" Padding="14,8" Click="Email_Click"/>
                    <Button Content="在 GitHub 上留言" MinWidth="140" Padding="14,8" Margin="12,0,0,0" Click="Issues_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Content="关闭" Width="100" Margin="0,20,0,0" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
