<Window x:Class="StudentScoreTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="/Assets/app.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="数据匹配助手" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="VersionTextBlock" Margin="0,4,0,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="作者："/>
            <Run FontWeight="SemiBold" Text="Seul_SC_照晨"/>
        </TextBlock>
        <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="GitHub："/>
            <Hyperlink NavigateUri="https://github.com/Seul-SC/DataMatchingAssistant"
                       RequestNavigate="GitHubLink_RequestNavigate">
                https://github.com/Seul-SC/DataMatchingAssistant
            </Hyperlink>
        </TextBlock>

        <Border Margin="0,22,0,0" Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="赞赏作者" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="请作者喝杯咖啡。支持作者完全自愿，不赞赏也可以使用全部功能。"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource QrPlaceholderBorder}">
                            <Grid>
                                <Image x:Name="WeChatQrImage" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                                <TextBlock x:Name="WeChatQrPlaceholder"
                                           Text="微信赞赏码&#x0a;（待添加）"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="微信" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource QrPlaceholderBorder}">
                            <Grid>
                                <Image x:Name="AlipayQrImage" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                                <TextBlock x:Name="AlipayQrPlaceholder"
                                           Text="支付宝赞赏码&#x0a;（待添加）"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="支付宝" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Button Content="关闭" Width="100" Margin="0,20,0,0" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
