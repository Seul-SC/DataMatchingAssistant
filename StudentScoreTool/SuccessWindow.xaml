<Window x:Class="StudentScoreTool.SuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="处理完成"
        Width="680"
        MinWidth="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="28,24,28,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="StickerPanel" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,18,0"/>
            <TextBlock x:Name="MessageTextBlock" Grid.Column="1"
                       Style="{StaticResource HumorText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Margin="0,16,0,0" Padding="16,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="SummaryTextBlock" FontSize="13.5" TextWrapping="Wrap"
                           LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="NoteTextBlock" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                           LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Button Content="好的" Width="108" Height="40" Margin="0,22,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}"
                FontSize="14"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
