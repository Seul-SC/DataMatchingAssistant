<Window x:Class="StudentScoreTool.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="520" Height="460"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTextBlock" Text="发现新版本" FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SummaryTextBlock" Margin="0,8,0,0" FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesTextBlock" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ProgressTextBlock" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed"/>
            <ProgressBar x:Name="DownloadProgressBar" Height="6" Margin="0,8,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" Content="稍后" Width="100" Height="36"
                    Margin="0,0,10,0" IsCancel="True" Click="Later_Click"/>
            <Button x:Name="UpdateButton" Content="更新" Width="132" Height="36"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Update_Click"/>
        </StackPanel>
    </Grid>
</Window>
