<Window x:Class="StudentScoreTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据匹配助手"
        Icon="/Assets/app.png"
        Width="760" Height="650"
        MinWidth="680" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DBE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EDF3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="数据匹配助手" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="选择两个 Excel 文件，自动把学生成绩填入名单表。"
                       Margin="0,7,0,0" FontSize="14" Foreground="#667085"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="1  有成绩的 Excel"
                           FontSize="15" FontWeight="SemiBold" Foreground="#25324A"/>
                <TextBox x:Name="SourcePathTextBox" Grid.Row="1" Grid.Column="0"
                         Margin="0,12,12,0" Height="36" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="#F9FAFB" BorderBrush="#DDE2E8"
                         ToolTip="来源成绩文件路径"/>
                <Button x:Name="SourceBrowseButton" Grid.Row="1" Grid.Column="1"
                        Margin="0,12,0,0" Content="选择文件" Click="SelectSource_Click"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="工作表" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,10,0"/>
                    <ComboBox x:Name="SourceSheetComboBox" MinWidth="250"
                              SelectionChanged="SheetComboBox_SelectionChanged"/>
                    <TextBlock x:Name="SourceSheetHint" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#98A2B3" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="2  需要填写成绩的名单 Excel"
                           FontSize="15" FontWeight="SemiBold" Foreground="#25324A"/>
                <TextBox x:Name="TargetPathTextBox" Grid.Row="1" Grid.Column="0"
                         Margin="0,12,12,0" Height="36" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="#F9FAFB" BorderBrush="#DDE2E8"
                         ToolTip="将被更新的名单文件路径"/>
                <Button x:Name="TargetBrowseButton" Grid.Row="1" Grid.Column="1"
                        Margin="0,12,0,0" Content="选择文件" Click="SelectTarget_Click"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="工作表" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,10,0"/>
                    <ComboBox x:Name="TargetSheetComboBox" MinWidth="250"
                              SelectionChanged="SheetComboBox_SelectionChanged"/>
                    <TextBlock x:Name="TargetSheetHint" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#98A2B3" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="BackupCheckBox" IsChecked="True"
                      Content="处理前自动备份名单原文件（推荐）"
                      Foreground="#475467" FontSize="13"/>
            <TextBlock Text="只写入已有成绩列；公式单元格和来源空白成绩不会被覆盖。"
                       Margin="20,6,0,0" Foreground="#98A2B3" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,22,0,0">
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                    Content="开始处理" Click="Start_Click" IsEnabled="False"/>
            <ProgressBar x:Name="WorkingProgressBar" Height="3" Margin="0,14,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusTextBlock" Margin="0,10,0,0"
                       Text="请选择来源文件和名单文件。"
                       TextAlignment="Center" Foreground="#667085" FontSize="13"/>
        </StackPanel>

        <TextBlock Grid.Row="6" VerticalAlignment="Bottom" TextAlignment="Center"
                   Text="常见表格完全在本地处理，不会上传学生数据。"
                   Foreground="#98A2B3" FontSize="12"/>
    </Grid>
</Window>
