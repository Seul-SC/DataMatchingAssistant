<Window x:Class="StudentScoreTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据匹配助手"
        Icon="/Assets/app.png"
        Width="800" Height="760"
        MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="数据匹配助手" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionTextBlock" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="选择两个 Excel 文件，自动把学生成绩填入名单表。"
                                   Margin="0,2,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="外观" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <Button x:Name="ThemeLightButton" Style="{StaticResource ThemeSwatchButton}"
                            Tag="Light" ToolTip="浅色" Click="ThemeSwatch_Click"
                            AutomationProperties.Name="浅色">
                        <Border x:Name="ThemeLightRing" Width="22" Height="22" CornerRadius="11"
                                BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}"
                                Background="#F3F4F6"/>
                    </Button>
                    <Button x:Name="ThemeDarkButton" Style="{StaticResource ThemeSwatchButton}"
                            Tag="Dark" ToolTip="深色" Click="ThemeSwatch_Click"
                            AutomationProperties.Name="深色">
                        <Border x:Name="ThemeDarkRing" Width="22" Height="22" CornerRadius="11"
                                BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}"
                                Background="#1B1D21"/>
                    </Button>
                    <Button x:Name="ThemeMintLightButton" Style="{StaticResource ThemeSwatchButton}"
                            Tag="MintLight" ToolTip="薄荷绿" Click="ThemeSwatch_Click"
                            AutomationProperties.Name="薄荷绿">
                        <Border x:Name="ThemeMintLightRing" Width="22" Height="22" CornerRadius="11"
                                BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}"
                                Background="#98FF98"/>
                    </Button>
                    <Button x:Name="ThemeMintDeepButton" Style="{StaticResource ThemeSwatchButton}"
                            Tag="MintDeep" ToolTip="深薄荷" Click="ThemeSwatch_Click"
                            AutomationProperties.Name="深薄荷">
                        <Border x:Name="ThemeMintDeepRing" Width="22" Height="22" CornerRadius="11"
                                BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}"
                                Background="#3EB489"/>
                    </Button>

                    <Grid Margin="16,0,0,0">
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource ToolbarButton}"
                                Content="检查更新" Click="CheckUpdate_Click" Padding="14,0,16,0"/>
                        <Ellipse x:Name="UpdateBadge" Width="10" Height="10"
                                 Fill="{DynamicResource DangerBrush}"
                                 Stroke="{DynamicResource TopBarBackgroundBrush}"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-3,-3,0"
                                 Visibility="Collapsed"
                                 IsHitTestVisible="False"
                                 ToolTip="发现新版本"/>
                    </Grid>
                    <Button Content="关于" Style="{StaticResource ToolbarButton}"
                            Margin="8,0,0,0" Click="About_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="28,0,28,16"
                   Text="所有表格均在本地处理，不会上传学生数据。检查更新时只向 GitHub 查询版本信息。"
                   TextAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,12">
                <Border x:Name="SourceDropBorder" Style="{StaticResource FileCardBorder}"
                        AllowDrop="True"
                        DragEnter="Source_DragEnter"
                        DragOver="Source_DragOver"
                        DragLeave="Source_DragLeave"
                        Drop="Source_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1  有成绩的 Excel"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button x:Name="SourceBrowseButton" Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource ToolbarButton}" Content="选择文件"
                                Click="SelectSource_Click"/>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <TextBlock x:Name="SourcePlaceholderText"
                                       Text="将 .xlsx 文件拖到这里，或点击右上角选择文件"
                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="SourceFileNameText" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SourceFilePathText" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="工作表" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="SourceSheetComboBox" MinWidth="260"
                                      SelectionChanged="SheetComboBox_SelectionChanged"/>
                            <TextBlock x:Name="SourceSheetHint" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="TargetDropBorder" Style="{StaticResource FileCardBorder}"
                        AllowDrop="True"
                        DragEnter="Target_DragEnter"
                        DragOver="Target_DragOver"
                        DragLeave="Target_DragLeave"
                        Drop="Target_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="2  需要填写成绩的名单 Excel"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button x:Name="TargetBrowseButton" Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource ToolbarButton}" Content="选择文件"
                                Click="SelectTarget_Click"/>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <TextBlock x:Name="TargetPlaceholderText"
                                       Text="将 .xlsx 文件拖到这里，或点击右上角选择文件"
                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="TargetFileNameText" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TargetFilePathText" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="工作表" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="TargetSheetComboBox" MinWidth="260"
                                      SelectionChanged="SheetComboBox_SelectionChanged"/>
                            <TextBlock x:Name="TargetSheetHint" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Margin="4,2,4,0">
                    <CheckBox x:Name="BackupCheckBox" IsChecked="True"
                              Content="处理前自动备份名单原文件（推荐）"/>
                    <TextBlock Text="只写入已有成绩列；公式单元格和来源空白成绩不会被覆盖。"
                               Margin="22,6,0,0" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Margin="0,22,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                            Content="开始处理" Click="Start_Click" IsEnabled="False"/>
                    <ProgressBar x:Name="WorkingProgressBar" Height="4" Margin="0,14,0,0"
                                 IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,12,0,0"
                               Text="请选择来源文件和名单文件。"
                               TextAlignment="Center" FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="OpenOutputFolderButton" Style="{StaticResource LinkButton}"
                            Content="打开所在文件夹"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OpenOutputFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
