<Window x:Class="StudentScoreTool.IssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认异常记录"
        Width="680" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="以下记录需要确认" FontSize="21" FontWeight="SemiBold" Foreground="#202939"/>
            <TextBlock Text="继续后会跳过这些异常，只写入能够明确匹配的成绩；取消不会修改名单文件。"
                       Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#667085"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="7">
            <ListBox x:Name="IssueListBox" BorderThickness="0" Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5" Foreground="#344054"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="跳过异常并继续" Width="160" Height="36" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
