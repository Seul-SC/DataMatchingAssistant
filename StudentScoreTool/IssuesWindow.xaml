<Window x:Class="StudentScoreTool.IssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要留意的问题"
        Width="780" Height="660"
        MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StickerBorder" Width="120" Height="120" Background="Transparent" BorderThickness="0">
                <Image x:Name="StickerImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="处理完成，不过有几处要看一看"
                           FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="IntroTextBlock" Margin="0,8,0,0" FontSize="14"
                           TextWrapping="Wrap" LineHeight="22"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Margin="0,12,0,0" Padding="10,8"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <TextBlock x:Name="FilesTextBlock" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <ScrollViewer Padding="16,14" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,2"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountText}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12,10"
                                                    Background="{DynamicResource CardAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="2"
                                                            Background="{DynamicResource AttentionBrush}"
                                                            Width="4" HorizontalAlignment="Left"/>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Headline}" FontSize="14"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Message}" Margin="0,4,0,0"
                                                                   FontSize="13" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <Grid Visibility="{Binding ComparisonVisibility}" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Padding="8,6" CornerRadius="6"
                                                                    Background="{DynamicResource InputBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding LeftLabel}" FontSize="11"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding LeftValue}" Margin="0,2,0,0"
                                                                               FontSize="14" FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="2" Padding="8,6" CornerRadius="6"
                                                                    Background="{DynamicResource InputBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding RightLabel}" FontSize="11"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding RightValue}" Margin="0,2,0,0"
                                                                               FontSize="14" FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource AttentionBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="知道了" Width="120" Height="40"
                    Style="{StaticResource PrimaryButton}" FontSize="14"
                    IsDefault="True" IsCancel="True" Click="Close_Click"/>
            <TextBlock Text="关闭后，可在主界面再次打开这份清单。"
                       VerticalAlignment="Center" FontSize="12.5"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
