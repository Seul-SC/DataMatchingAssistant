<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DataMatchingAssistant</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>数据匹配助手</Product>
    <Company>Seul_SC_照晨</Company>
    <Description>在本地匹配表格数据并将成绩写入现有 Excel 名单表。</Description>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <StartupObject>StudentScoreTool.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\tips-wechat.png" Condition="Exists('Assets\tips-wechat.png')" />
    <Resource Include="Assets\tips-alipay.png" Condition="Exists('Assets\tips-alipay.png')" />
  </ItemGroup>

</Project>
