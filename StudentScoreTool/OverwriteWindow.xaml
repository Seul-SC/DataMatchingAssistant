<Window x:Class="StudentScoreTool.OverwriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认是否覆盖已有成绩"
        Width="820" Height="600"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="这些格子里原来已有成绩" FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SummaryTextBlock" Margin="0,8,0,0" FontSize="13.5"
                       TextWrapping="Wrap" LineHeight="22"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="姓名" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="学号" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="成绩列" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="4" Text="原成绩" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="5" Text="新成绩" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource CardAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudentName}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StudentId}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ScoreColumn}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CurrentValue}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding IncomingValue}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AttentionBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="全部跳过" Width="108" Height="40" Margin="0,0,8,0"
                        Click="SkipAll_Click"/>
                <Button Content="按勾选覆盖" Width="132" Height="40"
                        Style="{StaticResource PrimaryButton}" FontSize="14"
                        IsDefault="True" Click="Confirm_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全选覆盖" Width="108" Height="40" Margin="0,0,8,0"
                        Click="SelectAll_Click"/>
                <TextBlock x:Name="SelectionHintText" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
